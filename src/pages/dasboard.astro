---
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Account Dashboard</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f7fb;
      color: #172033;
    }

    .topbar {
      background: #172033;
      color: white;
      padding: 18px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand {
      font-size: 21px;
      font-weight: bold;
    }

    .logout {
      background: white;
      color: #172033;
      border: 0;
      border-radius: 6px;
      padding: 10px 18px;
      cursor: pointer;
      font-weight: bold;
    }

    .container {
      width: 92%;
      max-width: 1100px;
      margin: 35px auto;
    }

    .welcome {
      margin-bottom: 25px;
    }

    .welcome h1 {
      margin: 0 0 8px;
      font-size: 30px;
    }

    .welcome p {
      margin: 0;
      color: #687386;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .card {
      background: white;
      border-radius: 12px;
      padding: 25px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .balance-card {
      grid-column: span 2;
    }

    .label {
      color: #687386;
      font-size: 14px;
      margin-bottom: 10px;
    }

    .balance {
      font-size: 38px;
      font-weight: bold;
      margin-bottom: 12px;
    }

    .account {
      color: #687386;
      font-size: 14px;
    }

    .card h2 {
      margin-top: 0;
      font-size: 20px;
    }

    .activity {
      margin-top: 25px;
    }

    .transaction {
      display: flex;
      justify-content: space-between;
      padding: 16px 0;
      border-bottom: 1px solid #e5e9ef;
    }

    .transaction:last-child {
      border-bottom: 0;
    }

    .transaction-name {
      font-weight: bold;
    }

    .transaction-date {
      color: #7b8494;
      font-size: 13px;
      margin-top: 4px;
    }

    @media (max-width: 750px) {
      .grid {
        grid-template-columns: 1fr;
      }

      .balance-card {
        grid-column: span 1;
      }
    }
  </style>
</head>

<body>

  <header class="topbar">
    <div class="brand">Account Portal</div>

    <button class="logout" id="logoutButton">
      Logout
    </button>
  </header>

  <main class="container">

    <section class="welcome">
      <h1 id="welcomeName">Welcome</h1>
      <p>Manage your account and view your account information.</p>
    </section>

    <section class="grid">

      <div class="card balance-card">
        <div class="label">Account Balance</div>

        <div class="balance">$25,000.00</div>

        <div class="account">
          Account •••• 4821
        </div>
      </div>

      <div class="card">
        <h2>Account Information</h2>

        <div class="label">Account holder</div>
        <strong id="accountName">—</strong>

        <div class="label" style="margin-top:18px;">
          Email
        </div>
        <strong id="accountEmail">—</strong>
      </div>

      <div class="card">
        <h2>Account Status</h2>

        <p>
          Your account portal is active.
        </p>
      </div>

    </section>

    <section class="card activity">
      <h2>Recent Activity</h2>

      <div class="transaction">
        <div>
          <div class="transaction-name">Account Created</div>
          <div class="transaction-date">Recent activity</div>
        </div>

        <div>—</div>
      </div>

      <div class="transaction">
        <div>
          <div class="transaction-name">Profile Information</div>
          <div class="transaction-date">Recent activity</div>
        </div>

        <div>—</div>
      </div>

    </section>

  </main>

  <script>
    const loggedIn = sessionStorage.getItem("loggedIn");
    const savedAccount = localStorage.getItem("fictionalAccount");

    if (loggedIn !== "true" || !savedAccount) {
      window.location.href = "/login";
    } else {
      const account = JSON.parse(savedAccount);

      document.getElementById("welcomeName").textContent =
        `Welcome, ${account.fullName}`;

      document.getElementById("accountName").textContent =
        account.fullName;

      document.getElementById("accountEmail").textContent =
        account.email;
    }

    const logoutButton = document.getElementById("logoutButton");

    logoutButton?.addEventListener("click", () => {
      sessionStorage.removeItem("loggedIn");
      window.location.href = "/login";
    });
  </script>

</body>
</html>

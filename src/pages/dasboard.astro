<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In</title>

  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #f4f7fb;
      font-family: Arial, sans-serif;
    }

    .card {
      width: 100%;
      max-width: 520px;
      padding: 35px;
      background: white;
      border-radius: 10px;
      box-shadow: 0 5px 25px rgba(0,0,0,.08);
    }

    h1 {
      margin-top: 0;
      color: #172033;
    }

    label {
      display: block;
      margin: 20px 0 8px;
      font-weight: bold;
    }

    input {
      width: 100%;
      height: 52px;
      padding: 0 15px;
      border: 1px solid #cbd5e1;
      border-radius: 7px;
      box-sizing: border-box;
      font-size: 16px;
    }

    button {
      width: 100%;
      height: 52px;
      margin-top: 25px;
      border: 0;
      border-radius: 7px;
      background: #2437c7;
      color: white;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
    }

    .back {
      display: block;
      margin-top: 20px;
      text-align: center;
      color: #2437c7;
      text-decoration: none;
    }

    .notice {
      margin-top: 20px;
      padding: 12px;
      background: #eef4ff;
      border-left: 4px solid #2437c7;
      color: #475569;
      font-size: 13px;
    }
  </style>
</head>

<body>

  <main class="card">

    <h1>Sign In</h1>

    <p>Sign in to access your fictional account dashboard.</p>

    <form id="loginForm">

      <label for="email">
        Email Address
      </label>

      <input
        id="email"
        type="email"
        placeholder="user@example.com"
        required
      />

      <label for="password">
        Password
      </label>

      <input
        id="password"
        type="password"
        placeholder="Password"
        required
      />

      <button type="submit">
        Sign In
      </button>

    </form>

    <a class="back" href="/">
      Create an account
    </a>

    <div class="notice">
      Fictional website for demonstration purposes only.
    </div>

  </main>

  <script>
    const form = document.querySelector("#loginForm");

    form?.addEventListener("submit", (event) => {
      event.preventDefault();

      window.location.href = "/dashboard";
    });
  </script>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create an Account</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f7fb;
      color: #111827;
    }

    .container {
      max-width: 850px;
      margin: 40px auto;
      padding: 30px;
      background: white;
      border-radius: 14px;
      box-shadow: 0 8px 30px rgba(0,0,0,.08);
    }

    .tabs {
      display: flex;
      gap: 18px;
      margin-bottom: 45px;
    }

    .tabs button {
      flex: 1;
      padding: 17px;
      border-radius: 8px;
      font-size: 17px;
      cursor: pointer;
      border: 2px solid #2437c7;
      background: white;
      color: #2437c7;
    }

    .tabs .active {
      background: #2437c7;
      color: white;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px 30px;
    }

    .field {
      display: flex;
      flex-direction: column;
    }

    label {
      font-size: 17px;
      font-weight: 700;
      margin-bottom: 9px;
    }

    input,
    select {
      width: 100%;
      height: 58px;
      padding: 0 18px;
      border: 1px solid #cbd5e1;
      border-radius: 9px;
      background: #f8fafc;
      font-size: 17px;
      color: #172554;
      outline: none;
    }

    input:focus,
    select:focus {
      border: 2px solid #3b82f6;
      background: white;
    }

    .full {
      grid-column: 1 / -1;
    }

    .note {
      margin-top: 25px;
      color: #64748b;
      font-size: 15px;
      line-height: 1.6;
    }

    .submit {
      margin-top: 28px;
      width: 100%;
      height: 55px;
      border: 0;
      border-radius: 8px;
      background: #2437c7;
      color: white;
      font-size: 18px;
      font-weight: 700;
      cursor: pointer;
    }

    .submit:hover {
      background: #1d2eaa;
    }

    @media (max-width: 700px) {
      .form-grid {
        grid-template-columns: 1fr;
      }

      .full {
        grid-column: auto;
      }

      .container {
        margin: 15px;
        padding: 20px;
      }
    }
  </style>
</head>

<body>

  <div class="container">

    <div class="tabs">
      <button>Sign in</button>
      <button class="active">Create an account</button>
    </div>

    <form id="registrationForm">

      <div class="form-grid">

        <div class="field">
          <label>Full Name</label>
          <input
            type="text"
            name="fullName"
            placeholder="Enter your name"
            required
          >
        </div>

        <div class="field">
          <label>Email Address</label>
          <input
            type="email"
            name="email"
            placeholder="you@example.com"
            required
          >
        </div>

        <div class="field">
          <label>Reference ID</label>
          <input
            type="text"
            name="referenceId"
            placeholder="Optional reference ID"
          >
        </div>

        <div class="field">
          <label>Country</label>
          <select name="country">
            <option>United States</option>
            <option>Canada</option>
            <option>United Kingdom</option>
            <option>India</option>
            <option>Australia</option>
          </select>
        </div>

        <div class="field">
          <label>Mobile</label>
          <input
            type="tel"
            name="mobile"
            placeholder="Enter mobile number"
          >
        </div>

        <div class="field">
          <label>Alternate Mobile</label>
          <input
            type="tel"
            name="alternateMobile"
            placeholder="Optional"
          >
        </div>

        <div class="field full">
          <label>Registered Address</label>
          <input
            type="text"
            name="address"
            placeholder="Enter your address"
          >
        </div>

        <div class="field">
          <label>Password</label>
          <input
            type="password"
            name="password"
            placeholder="Create a password"
            autocomplete="new-password"
            required
          >
        </div>

        <div class="field">
          <label>Confirm Password</label>
          <input
            type="password"
            name="confirmPassword"
            placeholder="Confirm password"
            autocomplete="new-password"
            required
          >
        </div>

      </div>

      <p class="note">
        Account information will be generated after registration.
        This demonstration does not request or store government
        identification numbers.
      </p>

      <button class="submit" type="submit">
        Create Account
      </button>

    </form>

  </div>

  <script>
    document
      .getElementById("registrationForm")
      .addEventListener("submit", function(event) {

        event.preventDefault();

        const password = this.password.value;
        const confirmPassword = this.confirmPassword.value;

        if (password !== confirmPassword) {
          alert("Passwords do not match.");
          return;
        }

        alert("Account created successfully.");
      });
  </script>

</body>
</html>

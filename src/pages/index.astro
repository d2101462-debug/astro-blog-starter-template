---
const portalName = "Fictional Account Portal";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{portalName}</title>
  </head>

  <body>
    <header>
      <strong>{portalName}</strong>
    </header>

    <main>
      <section class="hero">
        <h1>Create Your Account</h1>
        <p>Set up your account for this fictional demonstration portal.</p>

        <div class="notice">
          <strong>Fictional demonstration</strong>
          <p>
            This site is not affiliated with any government agency, bank,
            financial institution, or authentication service.
          </p>
        </div>

        <form id="createAccount">
          <label>
            Full Name
            <input
              id="name"
              type="text"
              placeholder="Enter your name"
              required
            />
          </label>

          <label>
            Email Address
            <input
              id="email"
              type="email"
              placeholder="you@example.com"
              required
            />
          </label>

          <label>
            Password
            <input
              id="password"
              type="password"
              minlength="6"
              placeholder="At least 6 characters"
              required
            />
          </label>

          <button type="submit">Create Account</button>
        </form>
      </section>
    </main>

    <script>
      const form = document.getElementById("createAccount");

      form?.addEventListener("submit", (event) => {
        event.preventDefault();

        const name = document.getElementById("name").value;

        sessionStorage.setItem("portalUserName", name);

        window.location.href = "/dashboard";
      });
    </script>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #172033;
  }

  header {
    padding: 20px 7%;
    background: white;
    border-bottom: 1px solid #ddd;
    font-size: 20px;
  }

  main {
    max-width: 900px;
    margin: 50px auto;
    padding: 20px;
  }

  .hero {
    background: white;
    padding: 40px;
    border-radius: 14px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  h1 {
    margin-top: 0;
    font-size: 34px;
  }

  label {
    display: block;
    margin-top: 20px;
    font-weight: bold;
  }

  input {
    display: block;
    width: 100%;
    margin-top: 8px;
    padding: 14px;
    border: 1px solid #ccd3df;
    border-radius: 7px;
    font-size: 16px;
  }

  button {
    width: 100%;
    margin-top: 28px;
    padding: 15px;
    border: 0;
    border-radius: 7px;
    background: #2457c5;
    color: white;
    font-size: 17px;
    cursor: pointer;
  }

  .notice {
    margin-top: 25px;
    padding: 18px;
    border-left: 4px solid #2457c5;
    background: #f1f5ff;
  }

  .notice p {
    margin-bottom: 0;
  }
</style>

---
const countries = ["United States", "Canada", "United Kingdom", "Australia"];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Account Registration</title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f5f7fb;
        color: #172033;
      }

      .notice {
        background: #fff3cd;
        border-bottom: 1px solid #e4c766;
        padding: 10px;
        text-align: center;
        font-weight: bold;
        font-size: 14px;
      }

      .container {
        max-width: 900px;
        margin: 45px auto;
        background: white;
        padding: 42px 55px;
        border-radius: 8px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.08);
      }

      .brand {
        text-align: center;
        margin-bottom: 30px;
      }

      .logo {
        width: 58px;
        height: 58px;
        margin: auto;
        border-radius: 50%;
        border: 4px solid #174ea6;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #174ea6;
        font-weight: bold;
        font-size: 18px;
      }

      h1 {
        margin: 15px 0 8px;
        font-size: 26px;
      }

      .subtitle {
        color: #666;
        margin: 0;
      }

      .buttons {
        display: flex;
        justify-content: center;
        gap: 16px;
        margin: 25px 0 35px;
      }

      button {
        font-size: 16px;
        padding: 12px 35px;
        border-radius: 5px;
        cursor: pointer;
      }

      .signin {
        background: white;
        color: #174ea6;
        border: 1px solid #174ea6;
      }

      .create {
        background: #175cd3;
        color: white;
        border: 1px solid #175cd3;
      }

      form {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px 35px;
      }

      .field {
        display: flex;
        flex-direction: column;
      }

      .full {
        grid-column: 1 / -1;
      }

      label {
        font-weight: bold;
        margin-bottom: 8px;
      }

      input,
      select {
        height: 48px;
        padding: 0 14px;
        border: 1px solid #c8ced8;
        border-radius: 5px;
        font-size: 16px;
        background: white;
      }

      input:focus,
      select:focus {
        outline: none;
        border-color: #175cd3;
        box-shadow: 0 0 0 2px rgba(23, 92, 211, 0.12);
      }

      .submit {
        grid-column: 1 / -1;
        height: 50px;
        margin-top: 5px;
        background: #168f9a;
        color: white;
        border: none;
        font-size: 17px;
      }

      .help {
        grid-column: 1 / -1;
        text-align: center;
        color: #666;
        font-size: 14px;
        margin-top: -5px;
      }

      @media (max-width: 700px) {
        .container {
          margin: 20px;
          padding: 30px 22px;
        }

        form {
          grid-template-columns: 1fr;
        }

        .full,
        .submit,
        .help {
          grid-column: auto;
        }

        .buttons {
          flex-direction: column;
        }
      }
    </style>
  </head>

  <body>
    <div class="notice">
      FICTIONAL ACCOUNT PORTAL — NOT A GOVERNMENT OR FINANCIAL SERVICE
    </div>

    <main class="container">
      <div class="brand">
        <div class="logo">FA</div>

        <h1>Fictional Account Portal</h1>

        <p class="subtitle">
          Create an account to access your demonstration profile.
        </p>
      </div>

      <div class="buttons">
        <button type="button" class="signin">Sign in</button>
        <button type="button" class="create">Create an account</button>
      </div>

      <form>
        <div class="field">
          <label for="name">Full Name</label>
          <input id="name" type="text" placeholder="Your full name" />
        </div>

        <div class="field">
          <label for="email">Email Address</label>
          <input id="email" type="email" placeholder="you@example.com" />
        </div>

        <div class="field">
          <label for="member">SSN</label>
          <input id="member" type="text" placeholder="Enter member ID" />
        </div>

        <div class="field">
          <label for="country">Country</label>
          <select id="country">
            {countries.map((country) => (
              <option value={country}>{country}</option>
            ))}
          </select>
        </div>

        <div class="field">
          <label for="mobile">Mobile</label>
          <input id="mobile" type="tel" placeholder="Phone number" />
        </div>

        <div class="field">
          <label for="alternate">Alternate Mobile</label>
          <input id="alternate" type="tel" placeholder="Optional phone number" />
        </div>

        <div class="field full">
          <label for="address">Registered Address</label>
          <input id="address" type="text" placeholder="Example address" />
        </div>

        <div class="field">
          <label for="password">Password</label>
          <input id="password" type="password" placeholder="At least 8 characters" />
        </div>

        <div class="field">
          <label for="confirm">Confirm Password</label>
          <input id="confirm" type="password" placeholder="Re-enter password" />
        </div>

        <button class="submit" type="button">
          Create Account
        </button>

        <div class="help">
          This is a fictional demonstration interface. Do not enter sensitive
          personal information.
        </div>
      </form>
    </main>
  </body>
</html>

---
const userName = "Demo User";
const accountStatus = "Active";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Fictional Portal — Dashboard</title>
  </head>

  <body>
    <header>
      <strong>Fictional Portal</strong>
      <nav>
        <a href="/">Home</a>
        <a href="/dashboard">Dashboard</a>
      </nav>
    </header>

    <main>
      <h1>Welcome, {userName}</h1>
      <p>Your fictional account dashboard</p>

      <section class="cards">
        <div class="card">
          <span>Account Status</span>
          <strong>{accountStatus}</strong>
        </div>

        <div class="card">
          <span>Profile</span>
          <strong>Complete</strong>
        </div>

        <div class="card">
          <span>Activity</span>
          <strong>0 transactions</strong>
        </div>
      </section>

      <section class="notice">
        <strong>Fictional portal</strong>
        <p>
          This dashboard is for demonstration purposes and is not affiliated
          with any government agency, bank, or financial institution.
        </p>
      </section>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f5f7fb;
    color: #172033;
  }

  header {
    display: flex;
    justify-content: space-between;
    padding: 20px 7%;
    background: white;
    border-bottom: 1px solid #ddd;
  }

  nav a {
    margin-left: 20px;
    text-decoration: none;
    color: #2457c5;
  }

  main {
    max-width: 1000px;
    margin: 50px auto;
    padding: 0 25px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 30px;
  }

  .card,
  .notice {
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 2px 10px rgba(0,0,0,.06);
  }

  .card span {
    display: block;
    color: #667085;
    margin-bottom: 10px;
  }

  .card strong {
    font-size: 20px;
  }

  .notice {
    margin-top: 30px;
    border-left: 4px solid #2457c5;
  }

  @media (max-width: 700px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>

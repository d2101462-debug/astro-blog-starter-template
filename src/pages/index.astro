<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Account Portal</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f3f6fa;
      color: #172033;
    }

    header {
      background: #12345b;
      color: white;
      padding: 18px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand {
      font-size: 21px;
      font-weight: 700;
    }

    .secure {
      font-size: 13px;
      opacity: 0.85;
    }

    main {
      max-width: 900px;
      margin: 45px auto;
      padding: 0 20px;
    }

    .card {
      background: white;
      border-radius: 12px;
      padding: 32px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    h1 {
      margin-top: 0;
      color: #12345b;
    }

    .subtitle {
      color: #667085;
      margin-bottom: 28px;
    }

    .field {
      margin-bottom: 18px;
    }

    label {
      display: block;
      font-weight: 600;
      margin-bottom: 7px;
    }

    input {
      width: 100%;
      padding: 13px;
      border: 1px solid #ccd3dd;
      border-radius: 7px;
      font-size: 15px;
    }

    button {
      width: 100%;
      border: 0;
      border-radius: 7px;
      padding: 14px;
      background: #12345b;
      color: white;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
    }

    button:hover {
      background: #0d2948;
    }

    #dashboard {
      display: none;
    }

    .account-box {
      background: #f3f6fa;
      border-radius: 8px;
      padding: 18px;
      margin-top: 20px;
    }

    .account-row {
      display: flex;
      justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid #ddd;
    }

    .account-row:last-child {
      border-bottom: 0;
    }

    .label {
      color: #667085;
    }
  </style>
</head>

<body>

  <header>
    <div class="brand">Account Portal</div>
    <div class="secure">Fictional test portal</div>
  </header>

  <main>

    <section id="registration" class="card">
      <h1>Create Test Account</h1>

      <p class="subtitle">
        Use test information only. No real passwords or financial information are required.
      </p>

      <form id="registrationForm">

        <div class="field">
          <label for="name">Name</label>
          <input id="name" type="text" required />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input id="email" type="email" required />
        </div>

        <div class="field">
          <label for="country">Country</label>
          <input id="country" type="text" required />
        </div>

        <div class="field">
          <label for="mobile">Mobile</label>
          <input id="mobile" type="text" required />
        </div>

        <button type="submit">Create Test Account</button>

      </form>
    </section>


    <section id="dashboard" class="card">

      <h1>Account Dashboard</h1>

      <p class="subtitle">
        Test account information
      </p>

      <div class="account-box">

        <div class="account-row">
          <span class="label">Name</span>
          <strong id="displayName"></strong>
        </div>

        <div class="account-row">
          <span class="label">Email</span>
          <strong id="displayEmail"></strong>
        </div>

        <div class="account-row">
          <span class="label">Country</span>
          <strong id="displayCountry"></strong>
        </div>

        <div class="account-row">
          <span class="label">Mobile</span>
          <strong id="displayMobile"></strong>
        </div>

        <div class="account-row">
          <span class="label">Test Account Number</span>
          <strong id="displayAccount"></strong>
        </div>

      </div>

    </section>

  </main>


  <script>
    const form = document.getElementById("registrationForm");

    form.addEventListener("submit", function (event) {
      event.preventDefault();

      const account = {
        name: document.getElementById("name").value.trim(),
        email: document.getElementById("email").value.trim(),
        country: document.getElementById("country").value.trim(),
        mobile: document.getElementById("mobile").value.trim(),
        accountNumber:
          "TEST-" +
          Math.floor(10000000 + Math.random() * 90000000)
      };

      document.getElementById("displayName").textContent = account.name;
      document.getElementById("displayEmail").textContent = account.email;
      document.getElementById("displayCountry").textContent = account.country;
      document.getElementById("displayMobile").textContent = account.mobile;
      document.getElementById("displayAccount").textContent =
        account.accountNumber;

      document.getElementById("registration").style.display = "none";
      document.getElementById("dashboard").style.display = "block";
    });
  </script>

</body>
</html>

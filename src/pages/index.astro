---
const userName = "Demo User";
const accountStatus = "Active";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Fictional Portal — Dashboard</title>
  </head>

  <body>
    <header>
      <strong>Fictional Portal Home</strong>
      <nav>
        <a href="/">Home</a>
        <a href="/dashboard">Dashboard</a>
      </nav>
    </header>

    <main>
      <h1>Welcome, {userName}</h1>
      <p>Your fictional account dashboard</p>

      <section class="cards">
        <div class="card">
          <span>Account Status</span>
          <strong>{accountStatus}</strong>
        </div>

        <div class="card">
          <span>Profile</span>
          <strong>Complete</strong>
        </div>

        <div class="card">
          <span>Activity</span>
          <strong>0 transactions</strong>
        </div>
      </section>

      <section class="notice">
        <strong>Fictional portal</strong>
        <p>
          This dashboard is for demonstration purposes and is not affiliated
          with any government agency, bank, or financial institution.
        </p>
      </section>
    </main>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #172033;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 7%;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  header strong {
    font-size: 20px;
  }

  nav a {
    margin-left: 24px;
    color: #2457c5;
    text-decoration: none;
    font-weight: 600;
  }

  nav a:hover {
    text-decoration: underline;
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 55px 7%;
  }

  h1 {
    margin-bottom: 10px;
    font-size: 38px;
  }

  main > p {
    color: #667085;
    font-size: 17px;
    margin-bottom: 35px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .card {
    background: #ffffff;
    padding: 28px;
    border-radius: 14px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.05);
  }

  .card span {
    display: block;
    color: #667085;
    margin-bottom: 12px;
    font-size: 14px;
  }

  .card strong {
    font-size: 22px;
  }

  .notice {
    margin-top: 30px;
    padding: 22px 25px;
    background: #ffffff;
    border-left: 4px solid #2457c5;
    border-radius: 10px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
  }

  .notice strong {
    display: block;
    margin-bottom: 10px;
  }

  .notice p {
    margin: 0;
    color: #475467;
    line-height: 1.6;
  }

  @media (max-width: 700px) {
    header {
      padding: 16px 5%;
    }

    nav a {
      margin-left: 12px;
    }

    main {
      padding: 35px 5%;
    }

    h1 {
      font-size: 30px;
    }

    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>

---
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Secure Account Portal</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f3f6fa;
      color: #172033;
    }

    header {
      background: #ffffff;
      border-bottom: 1px solid #d9dee8;
      padding: 20px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 25px;
      font-weight: 700;
      color: #3436bd;
    }

    .logo span {
      display: block;
      font-size: 12px;
      color: #667085;
      font-weight: 400;
      margin-top: 3px;
    }

    .support {
      font-size: 14px;
      color: #4b5565;
    }

    main {
      max-width: 900px;
      margin: 35px auto;
      padding: 0 20px;
    }

    .intro {
      text-align: center;
      margin-bottom: 25px;
    }

    .intro h1 {
      margin-bottom: 10px;
      font-size: 30px;
    }

    .intro p {
      color: #5f6b7a;
      max-width: 650px;
      margin: auto;
      line-height: 1.5;
    }

    .buttons {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin: 25px 0;
    }

    .button {
      padding: 12px 30px;
      border-radius: 7px;
      font-size: 15px;
      cursor: pointer;
      text-decoration: none;
    }

    .signin {
      border: 1px solid #3436bd;
      background: white;
      color: #3436bd;
    }

    .create {
      border: 1px solid #3436bd;
      background: #3436bd;
      color: white;
    }

    .card {
      background: white;
      border: 1px solid #dce1e8;
      border-radius: 10px;
      padding: 30px;
      box-shadow: 0 3px 15px rgba(20, 30, 50, 0.06);
    }

    .card h2 {
      margin-top: 0;
      margin-bottom: 25px;
      font-size: 23px;
    }

    form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .field {
      display: flex;
      flex-direction: column;
    }

    .full {
      grid-column: 1 / -1;
    }

    label {
      font-weight: 600;
      margin-bottom: 8px;
      font-size: 14px;
    }

    input,
    select {
      width: 100%;
      padding: 13px;
      border: 1px solid #cbd2dc;
      border-radius: 6px;
      font-size: 15px;
      outline: none;
    }

    input:focus,
    select:focus {
      border-color: #3436bd;
      box-shadow: 0 0 0 2px rgba(52, 54, 189, 0.1);
    }

    .notice {
      grid-column: 1 / -1;
      color: #667085;
      font-size: 13px;
      line-height: 1.5;
      margin-top: -5px;
    }

    .submit {
      grid-column: 1 / -1;
      border: 0;
      border-radius: 7px;
      padding: 14px;
      background: #167f8c;
      color: white;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
    }

    .submit:hover {
      background: #126c77;
    }

    footer {
      text-align: center;
      color: #7a8493;
      font-size: 13px;
      margin: 30px 0;
    }

    @media (max-width: 700px) {
      header {
        padding: 18px 20px;
      }

      .support {
        display: none;
      }

      main {
        margin-top: 20px;
      }

      form {
        grid-template-columns: 1fr;
      }

      .full,
      .notice,
      .submit {
        grid-column: auto;
      }

      .buttons {
        flex-direction: column;
      }

      .button {
        text-align: center;
      }

      .card {
        padding: 22px;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">
      Secure Account Portal
      <span>Online Financial Services</span>
    </div>

    <div class="support">
      Support: 1-800-555-0147
    </div>
  </header>

  <main>

    <section class="intro">
      <h1>Create Your Account</h1>

      <p>
        Register for your secure online account. After completing
        registration, you will be taken to your account dashboard.
      </p>

      <div class="buttons">
        <a class="button signin" href="/login">
          Sign in
        </a>

        <a class="button create" href="#registration">
          Create an account
        </a>
      </div>
    </section>

    <section class="card" id="registration">

      <h2>Account Registration</h2>

      <form id="registrationForm">

        <div class="field">
          <label for="name">Full Name</label>
          <input
            id="name"
            type="text"
            placeholder="Enter your full name"
            required
          />
        </div>

        <div class="field">
          <label for="email">Email Address</label>
          <input
            id="email"
            type="email"
            placeholder="name@example.com"
            required
          />
        </div>

        <div class="field">
          <label for="country">Country</label>

          <select id="country" required>
            <option value="">Select country</option>
            <option value="United States">United States</option>
            <option value="Canada">Canada</option>
            <option value="United Kingdom">United Kingdom</option>
            <option value="India">India</option>
            <option value="Australia">Australia</option>
          </select>
        </div>

        <div class="field">
          <label for="mobile">Mobile</label>
          <input
            id="mobile"
            type="tel"
            placeholder="+1 555 000 0000"
            required
          />
        </div>

        <div class="field full">
          <label for="address">Registered Address</label>
          <input
            id="address"
            type="text"
            placeholder="Enter your address"
            required
          />
        </div>

        <div class="field">
          <label for="password">Password</label>
          <input
            id="password"
            type="password"
            minlength="6"
            placeholder="At least 6 characters"
            required
          />
        </div>

        <div class="field">
          <label for="confirmPassword">Confirm Password</label>
          <input
            id="confirmPassword"
            type="password"
            minlength="6"
            placeholder="Re-enter password"
            required
          />
        </div>

        <div class="notice">
          Your registration information is used only for this fictional
          account portal. Do not enter real Social Security numbers,
          financial credentials, or other sensitive information.
        </div>

        <button class="submit" type="submit">
          Create Account
        </button>

      </form>

    </section>

    <footer>
      © 2026 Secure Account Portal · Fictional financial-service interface
    </footer>

  </main>

  <script>
    const form = document.getElementById("registrationForm");

    form?.addEventListener("submit", (event) => {
      event.preventDefault();

      const nameInput = document.getElementById("name");
      const emailInput = document.getElementById("email");
      const countryInput = document.getElementById("country");
      const mobileInput = document.getElementById("mobile");
      const addressInput = document.getElementById("address");
      const passwordInput = document.getElementById("password");
      const confirmPasswordInput = document.getElementById("confirmPassword");

      const name = nameInput.value.trim();
      const email = emailInput.value.trim();
      const country = countryInput.value;
      const mobile = mobileInput.value.trim();
      const address = addressInput.value.trim();
      const password = passwordInput.value;
      const confirmPassword = confirmPasswordInput.value;

      if (password !== confirmPassword) {
        alert("Passwords do not match.");
        return;
      }

      const account = {
        name,
        email,
        country,
        mobile,
        address
      };

      localStorage.setItem("account", JSON.stringify(account));

      window.location.href = "/dashboard";
    });
  </script>

</body>
</html>

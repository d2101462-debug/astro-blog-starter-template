---
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Secure Account Portal</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f6fb;
      color: #172033;
    }

    .page {
      min-height: 100vh;
    }

    header {
      background: #ffffff;
      border-bottom: 1px solid #d9dee8;
      padding: 18px 7%;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 25px;
      font-weight: 700;
      color: #3436bd;
    }

    .logo small {
      display: block;
      margin-top: 4px;
      color: #667085;
      font-size: 12px;
      font-weight: 400;
    }

    .support {
      color: #3436bd;
      font-size: 14px;
      font-weight: 600;
    }

    main {
      max-width: 850px;
      margin: 45px auto;
      padding: 0 25px;
    }

    .intro {
      text-align: center;
    }

    .intro h1 {
      font-size: 27px;
      margin: 0 0 10px;
    }

    .intro p {
      max-width: 650px;
      margin: 0 auto;
      font-size: 16px;
      line-height: 1.5;
      font-weight: 600;
    }

    .buttons {
      display: flex;
      justify-content: center;
      gap: 18px;
      margin: 28px 0 35px;
    }

    .top-button {
      padding: 13px 40px;
      border-radius: 6px;
      font-size: 15px;
      cursor: pointer;
      text-decoration: none;
    }

    .sign-in {
      background: white;
      color: #3436bd;
      border: 1px solid #3436bd;
    }

    .create {
      background: #3436bd;
      color: white;
      border: 1px solid #3436bd;
    }

    .form-card {
      background: white;
      padding: 30px;
      border-radius: 8px;
      border: 1px solid #dce1e8;
    }

    form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 35px;
      row-gap: 20px;
    }

    .field {
      display: flex;
      flex-direction: column;
    }

    .full {
      grid-column: 1 / -1;
    }

    label {
      font-weight: 700;
      font-size: 15px;
      margin-bottom: 8px;
    }

    input,
    select {
      width: 100%;
      height: 48px;
      border: 1px solid #cbd2dc;
      border-radius: 6px;
      padding: 0 14px;
      font-size: 15px;
      color: #172033;
      background: white;
    }

    input:focus,
    select:focus {
      outline: none;
      border-color: #3436bd;
      box-shadow: 0 0 0 2px rgba(52, 54, 189, 0.12);
    }

    .hint {
      grid-column: 1 / -1;
      color: #667085;
      font-size: 13px;
      margin-top: -3px;
    }

    .submit {
      grid-column: 1 / -1;
      height: 50px;
      border: none;
      border-radius: 6px;
      background: #167f8c;
      color: white;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
    }

    .submit:hover {
      background: #126d77;
    }

    footer {
      text-align: center;
      color: #7a8493;
      font-size: 12px;
      margin: 25px 0;
    }

    @media (max-width: 700px) {
      header {
        padding: 18px 20px;
      }

      .support {
        display: none;
      }

      main {
        margin: 25px auto;
        padding: 0 15px;
      }

      .buttons {
        flex-direction: column;
      }

      .top-button {
        text-align: center;
      }

      form {
        grid-template-columns: 1fr;
      }

      .full,
      .hint,
      .submit {
        grid-column: auto;
      }

      .form-card {
        padding: 20px;
      }
    }
  </style>
</head>

<body>
  <div class="page">

    <header>
      <div class="logo">
        Secure Account Portal
        <small>Online Financial Services</small>
      </div>

      <div class="support">
        Support: 1-800-555-0147
      </div>
    </header>

    <main>

      <section class="intro">
        <h1>Create Your Secure Account</h1>

        <p>
          Create an account to access your secure online financial-service
          portal.
        </p>

        <div class="buttons">
          <a class="top-button sign-in" href="/login">
            Sign in
          </a>

          <a class="top-button create" href="#registration">
            Create an account
          </a>
        </div>
      </section>

      <section class="form-card" id="registration">

        <form id="registrationForm">

          <div class="field">
            <label for="name">Full Name</label>
            <input
              id="name"
              type="text"
              placeholder="Enter your full name"
              required
            />
          </div>

          <div class="field">
            <label for="email">Email Address</label>
            <input
              id="email"
              type="email"
              placeholder="name@example.com"
              required
            />
          </div>

          <div class="field">
            <label for="country">Country</label>

            <select id="country" required>
              <option value="">Select country</option>
              <option>United States</option>
              <option>Canada</option>
              <option>United Kingdom</option>
              <option>India</option>
              <option>Australia</option>
            </select>
          </div>

          <div class="field">
            <label for="mobile">Mobile</label>
            <input
              id="mobile"
              type="tel"
              placeholder="Enter mobile number"
              required
            />
          </div>

          <div class="field full">
            <label for="address">Registered Address</label>
            <input
              id="address"
              type="text"
              placeholder="Enter your address"
              required
            />
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input
              id="password"
              type="password"
              minlength="6"
              placeholder="At least 6 characters"
              required
            />
          </div>

          <div class="field">
            <label for="confirmPassword">Confirm Password</label>
            <input
              id="confirmPassword"
              type="password"
              minlength="6"
              placeholder="Re-enter password"
              required
            />
          </div>

          <div class="hint">
            Account number will be generated automatically after registration.
          </div>

          <button class="submit" type="submit">
            Create Account
          </button>

        </form>

      </section>

      <footer>
        Secure Account Portal · Fictional financial-service interface
      </footer>

    </main>

  </div>

  <script>
    const form = document.getElementById("registrationForm");

    form?.addEventListener("submit", (event) => {
      event.preventDefault();

      const name = document.getElementById("name").value.trim();
      const email = document.getElementById("email").value.trim();
      const country = document.getElementById("country").value;
      const mobile = document.getElementById("mobile").value.trim();
      const address = document.getElementById("address").value.trim();

      const password = document.getElementById("password").value;
      const confirmPassword =
        document.getElementById("confirmPassword").value;

      if (password !== confirmPassword) {
        alert("Passwords do not match.");
        return;
      }

      const account = {
        name,
        email,
        country,
        mobile,
        address
      };

      localStorage.setItem(
        "account",
        JSON.stringify(account)
      );

      window.location.href = "/dashboard";
    });
  </script>

</body>
</html>

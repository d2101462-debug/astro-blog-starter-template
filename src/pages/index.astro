---
const portalName = "Gateway Account Portal";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{portalName}</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f7fb;
      color: #172033;
    }

    .header {
      background: #123b78;
      color: white;
      padding: 22px;
      text-align: center;
    }

    .header h1 {
      margin: 0;
      font-size: 28px;
    }

    .container {
      max-width: 900px;
      margin: 60px auto;
      padding: 20px;
    }

    .card {
      background: white;
      border-radius: 12px;
      padding: 45px;
      box-shadow: 0 4px 20px rgba(0,0,0,.10);
      text-align: center;
    }

    .card h2 {
      font-size: 30px;
      margin-bottom: 15px;
    }

    .card p {
      color: #555;
      line-height: 1.6;
    }

    .buttons {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin-top: 30px;
    }

    .button {
      display: inline-block;
      padding: 14px 28px;
      border-radius: 6px;
      text-decoration: none;
      font-weight: bold;
      border: 1px solid #1769d1;
    }

    .primary {
      background: #1769d1;
      color: white;
    }

    .secondary {
      background: white;
      color: #1769d1;
    }

    .notice {
      margin-top: 30px;
      padding: 15px;
      background: #eef5ff;
      border-radius: 6px;
      font-size: 14px;
    }
  </style>
</head>

<body>

  <header class="header">
    <h1>{portalName}</h1>
  </header>

  <main class="container">
    <section class="card">

      <h2>Welcome</h2>

      <p>
        Welcome to the Gateway Account Portal.
        Create a fictional account or sign in to continue.
      </p>

      <div class="buttons">
        <a class="button secondary" href="/signin">
          Sign in
        </a>

        <a class="button primary" href="/create-account">
          Create an account
        </a>
      </div>

      <div class="notice">
        This is a fictional demonstration portal and is not connected
        to any government agency, bank, or financial institution.
      </div>

    </section>
  </main>

</body>
</html>

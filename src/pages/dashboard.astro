</html>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Secure Account Dashboard</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f6fb;
      color: #172033;
    }

    .topbar {
      height: 62px;
      background: #18205a;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      font-weight: 600;
    }

    .layout {
      display: flex;
      min-height: calc(100vh - 62px);
    }

    .sidebar {
      width: 220px;
      background: white;
      border-right: 1px solid #d8dde6;
      padding: 18px 14px;
    }

    .brand {
      padding: 8px 12px 25px;
      color: #3436bd;
      font-size: 21px;
      font-weight: 700;
    }

    .brand small {
      display: block;
      color: #6b7280;
      font-size: 11px;
      margin-top: 4px;
      font-weight: 400;
    }

    .menu-title {
      font-size: 11px;
      font-weight: 700;
      color: #777f8e;
      margin: 0 10px 10px;
      text-transform: uppercase;
    }

    .nav {
      display: block;
      width: 100%;
      border: 0;
      background: transparent;
      padding: 12px 10px;
      margin-bottom: 4px;
      border-radius: 6px;
      text-align: left;
      font-size: 14px;
      color: #27314a;
      cursor: pointer;
    }

    .nav:hover,
    .nav.active {
      background: #e9eaff;
      color: #3436bd;
      font-weight: 600;
    }

    .logout {
      margin-top: 35px;
      background: white;
      border: 0;
      color: #4b5563;
      cursor: pointer;
      padding: 10px;
      font-size: 13px;
    }

    .content {
      flex: 1;
      padding: 22px 28px;
      overflow-x: auto;
    }

    .account-bar {
      background: white;
      border: 1px solid #dce1e8;
      padding: 15px 18px;
      display: flex;
      justify-content: space-between;
      margin-bottom: 24px;
      font-size: 14px;
      line-height: 1.8;
    }

    .account-label {
      font-weight: 700;
    }

    .status {
      text-align: right;
    }

    .on {
      color: #18834b;
      font-weight: 700;
    }

    h1 {
      font-size: 29px;
      margin: 0 0 25px;
    }

    .summary {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 25px;
    }

    .summary-card {
      padding: 8px 12px 18px;
      border-bottom: 1px solid #dce1e8;
    }

    .summary-card .label {
      color: #52607a;
      font-size: 14px;
      margin-bottom: 12px;
    }

    .amount {
      font-size: 30px;
      color: #172033;
    }

    .tables {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .table-card {
      background: white;
      border: 1px solid #dce1e8;
      border-radius: 6px;
      overflow: hidden;
    }

    .table-title {
      padding: 13px 15px;
      font-weight: 700;
      border-bottom: 1px solid #dce1e8;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      padding: 11px;
      border-bottom: 1px solid #edf0f4;
      text-align: left;
      font-size: 12px;
    }

    th {
      color: #4f5b70;
      font-weight: 700;
    }

    .empty {
      text-align: center;
      color: #718096;
      padding: 30px;
    }

    .footer {
      text-align: center;
      color: #697386;
      font-size: 12px;
      padding: 35px 0 10px;
    }

    @media (max-width: 900px) {
      .summary {
        grid-template-columns: repeat(2, 1fr);
      }

      .tables {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 650px) {
      .sidebar {
        width: 72px;
      }

      .brand,
      .menu-title {
        display: none;
      }

      .content {
        padding: 15px;
      }

      .account-bar {
        flex-direction: column;
      }

      .status {
        text-align: left;
      }

      .summary {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <div class="topbar">
    FRS Portal·Online Support
  </div>

  <div class="layout">

    <aside class="sidebar">

      <div class="brand">
        Secure Portal
        <small>FRS Gateway</small>
      </div>

      <div class="menu-title">Menu</div>

      <button class="nav active">▣ Dashboard</button>
      <button class="nav">▣ Deposit</button>
      <button class="nav">▣ Withdraw</button>
      <button class="nav">⇄ Transfer</button>
      <button class="nav">◌ Transactions</button>
      <button class="nav">▱ Support</button>
      <button class="nav">⚙ Settings</button>

      <button class="logout" id="logout">
        Log Out
      </button>

    </aside>

    <main class="content">

      <section class="account-bar">

        <div>
          <span class="account-label">Account No:</span>
          <span id="accountNumber">Loading...</span>

          <br />

          <span class="account-label">Name:</span>
          <span id="displayName">Loading...</span>

          <br />

          <span class="account-label">Email:</span>
          <span id="displayEmail">Loading...</span>
        </div>

        <div class="status">
          Account Status:
          <span class="on">● Active</span>
          <br />

          Secure Connection:
          <span class="on">● On</span>
        </div>

      </section>

      <h1>Dashboard</h1>

      <section class="summary">

        <div class="summary-card">
          <div class="label">Balance</div>
          <div class="amount">$0.00</div>
        </div>

        <div class="summary-card">
          <div class="label">Pending Deposits</div>
          <div class="amount">0</div>
        </div>

        <div class="summary-card">
          <div class="label">Pending Withdrawals</div>
          <div class="amount">0</div>
        </div>

        <div class="summary-card">
          <div class="label">Today Transactions</div>
          <div class="amount">0</div>
        </div>

      </section>

      <section class="tables">

        <div class="table-card">

          <div class="table-title">
            Latest Credits
          </div>

          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Txn</th>
                <th>Source</th>
                <th>Status</th>
                <th>Amount</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td colspan="5" class="empty">
                  No credits yet.
                </td>
              </tr>
            </tbody>
          </table>

        </div>

        <div class="table-card">

          <div class="table-title">
            Latest Debits
          </div>

          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Txn</th>
                <th>Amount</th>
                <th>Status</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td colspan="4" class="empty">
                  No debits yet.
                </td>
              </tr>
            </tbody>
          </table>

        </div>

      </section>

      <div class="footer">
       FRS Gateway
      </div>

    </main>

  </div>

  <script>
    const saved = localStorage.getItem("account");

    if (!saved) {
      window.location.href = "/";
    } else {
      try {
        const account = JSON.parse(saved);

        document.getElementById("displayName").textContent =
          account.name || "Account Holder";

        document.getElementById("displayEmail").textContent =
          account.email || "";

        document.getElementById("accountNumber").textContent =
          "SP-" + Math.floor(
            10000000 + Math.random() * 90000000
          );
      } catch {
        window.location.href = "/";
      }
    }

    document.getElementById("logout")?.addEventListener("click", () => {
      localStorage.removeItem("account");
      window.location.href = "/";
    });
  </script>

</body>
</html>

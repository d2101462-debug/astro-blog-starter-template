---
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Account Dashboard</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f6fb;
      color: #172033;
    }

    .topbar {
      height: 64px;
      background: #18205a;
      color: white;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 28px;
    }

    .brand {
      font-size: 22px;
      font-weight: 700;
    }

    .support {
      font-size: 14px;
    }

    .layout {
      display: flex;
      min-height: calc(100vh - 64px);
    }

    .sidebar {
      width: 220px;
      background: white;
      border-right: 1px solid #dce1e8;
      padding: 25px 15px;
    }

    .sidebar-title {
      font-size: 13px;
      font-weight: 700;
      color: #7a8493;
      margin: 0 10px 15px;
      text-transform: uppercase;
    }

    .nav-button {
      width: 100%;
      border: 0;
      background: transparent;
      padding: 13px 12px;
      text-align: left;
      border-radius: 7px;
      margin-bottom: 5px;
      color: #27314a;
      font-size: 14px;
      cursor: pointer;
    }

    .nav-button:hover,
    .nav-button.active {
      background: #eceeff;
      color: #3436bd;
      font-weight: 600;
    }

    .logout {
      margin-top: 35px;
      width: 100%;
      padding: 11px;
      border: 1px solid #3436bd;
      border-radius: 7px;
      background: #ffffff;
      color: #3436bd;
      cursor: pointer;
    }

    .main {
      flex: 1;
      padding: 28px;
      max-width: 1250px;
    }

    .account-bar {
      background: white;
      border: 1px solid #dce1e8;
      border-radius: 8px;
      padding: 18px 20px;
      margin-bottom: 25px;
      display: flex;
      justify-content: space-between;
      gap: 20px;
    }

    .account-info {
      line-height: 1.7;
      font-size: 14px;
    }

    .status {
      text-align: right;
      font-size: 13px;
      line-height: 1.8;
    }

    .online {
      color: #16834b;
      font-weight: 600;
    }

    h1 {
      margin: 0 0 25px;
      font-size: 30px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 25px;
    }

    .card {
      background: white;
      border: 1px solid #dce1e8;
      border-radius: 8px;
      padding: 20px;
      min-height: 115px;
    }

    .card-label {
      color: #667085;
      font-size: 14px;
      margin-bottom: 15px;
    }

    .card-value {
      font-size: 28px;
      font-weight: 400;
    }

    .tables {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .table-card {
      background: white;
      border: 1px solid #dce1e8;
      border-radius: 8px;
      overflow: hidden;
    }

    .table-title {
      padding: 17px;
      font-weight: 700;
      border-bottom: 1px solid #dce1e8;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      padding: 14px;
      text-align: left;
      font-size: 13px;
      border-bottom: 1px solid #edf0f4;
    }

    th {
      color: #667085;
      font-weight: 600;
    }

    .empty {
      text-align: center;
      color: #7a8493;
      padding: 30px;
    }

    footer {
      text-align: center;
      color: #7a8493;
      font-size: 12px;
      padding: 30px 0 10px;
    }

    @media (max-width: 900px) {
      .cards {
        grid-template-columns: repeat(2, 1fr);
      }

      .tables {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 650px) {
      .sidebar {
        width: 70px;
        padding: 15px 8px;
      }

      .sidebar-title {
        display: none;
      }

      .nav-button {
        font-size: 0;
        text-align: center;
      }

      .nav-button::first-letter {
        font-size: 20px;
      }

      .main {
        padding: 15px;
      }

      .account-bar {
        flex-direction: column;
      }

      .status {
        text-align: left;
      }

      .cards {
        grid-template-columns: 1fr;
      }

      .topbar {
        padding: 0 15px;
      }

      .support {
        display: none;
      }
    }
  </style>
</head>

<body>

  <header class="topbar">
    <div class="brand">Secure Account Portal</div>
    <div class="support">Support: 1-800-555-0147</div>
  </header>

  <div class="layout">

    <aside class="sidebar">
      <div class="sidebar-title">Menu</div>

      <button class="nav-button active">▣ Dashboard</button>
      <button class="nav-button">▣ Deposit</button>
      <button class="nav-button">▣ Withdraw</button>
      <button class="nav-button">⇄ Transfer</button>
      <button class="nav-button">◌ Transactions</button>
      <button class="nav-button">▱ Support</button>
      <button class="nav-button">⚙ Settings</button>

      <button class="logout" id="logoutButton">
        Log Out
      </button>
    </aside>

    <main class="main">

      <section class="account-bar">

        <div class="account-info">
          <strong>Account No:</strong>
          <span id="accountNumber">Loading...</span>
          <br />

          <strong>Name:</strong>
          <span id="displayName">Loading...</span>
          <br />

          <strong>Email:</strong>
          <span id="displayEmail">Loading...</span>
        </div>

        <div class="status">
          Account Status:
          <span class="online">● Active</span>
          <br />

          Connection:
          <span class="online">● Secure</span>
        </div>

      </section>

      <h1>Dashboard</h1>

      <section class="cards">

        <div class="card">
          <div class="card-label">Balance</div>
          <div class="card-value">$0.00</div>
        </div>

        <div class="card">
          <div class="card-label">Pending Deposits</div>
          <div class="card-value">0</div>
        </div>

        <div class="card">
          <div class="card-label">Pending Withdrawals</div>
          <div class="card-value">0</div>
        </div>

        <div class="card">
          <div class="card-label">Today Transactions</div>
          <div class="card-value">0</div>
        </div>

      </section>

      <section class="tables">

        <div class="table-card">
          <div class="table-title">Latest Credits</div>

          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Transaction</th>
                <th>Amount</th>
                <th>Status</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td colspan="4" class="empty">
                  No credits yet.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="table-card">
          <div class="table-title">Latest Debits</div>

          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Transaction</th>
                <th>Amount</th>
                <th>Status</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td colspan="4" class="empty">
                  No debits yet.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

      </section>

      <footer>
        Secure Account Portal · Fictional financial-service interface
      </footer>

    </main>

  </div>

  <script>
    const storedAccount = localStorage.getItem("account");

    if (storedAccount) {
      try {
        const account = JSON.parse(storedAccount);

        const nameElement = document.getElementById("displayName");
        const emailElement = document.getElementById("displayEmail");

        if (nameElement) {
          nameElement.textContent = account.name || "Account Holder";
        }

        if (emailElement) {
          emailElement.textContent = account.email || "";
        }
      } catch (error) {
        console.error("Unable to load account information.");
      }
    } else {
      window.location.href = "/";
    }

    const accountNumberElement =
      document.getElementById("accountNumber");

    if (accountNumberElement) {
      accountNumberElement.textContent = "SP-" + Math.floor(
        10000000 + Math.random() * 90000000
      );
    }

    const logoutButton =
      document.getElementById("logoutButton");

    logoutButton?.addEventListener("click", () => {
      localStorage.removeItem("account");
      window.location.href = "/";
    });
  </script>

</body>
</html>

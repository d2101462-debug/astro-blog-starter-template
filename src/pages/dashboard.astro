---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Account Dashboard</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f7fb;
      color: #172033;
    }

    .dashboard {
      max-width: 950px;
      margin: 40px auto;
      padding: 25px;
    }

    header {
      background: white;
      padding: 25px;
      border-radius: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    header h1 {
      margin: 0;
    }

    header p {
      margin-bottom: 0;
      color: #64748b;
    }

    .logout {
      padding: 11px 20px;
      border-radius: 7px;
      background: #2437c7;
      color: white;
      text-decoration: none;
      font-weight: bold;
    }

    .welcome {
      margin-top: 25px;
      background: white;
      padding: 30px;
      border-radius: 10px;
    }

    .details {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 20px;
    }

    .detail {
      background: white;
      padding: 22px;
      border-radius: 10px;
    }

    .detail span {
      display: block;
      color: #64748b;
      margin-bottom: 8px;
    }

    .detail strong {
      font-size: 18px;
      word-break: break-word;
    }

    .notice {
      margin-top: 25px;
      text-align: center;
      color: #64748b;
      font-size: 12px;
    }

    @media (max-width: 650px) {
      .details {
        grid-template-columns: 1fr;
      }

      header {
        gap: 20px;
      }
    }
  </style>
</head>

<body>

  <main class="FRS Gateway">

    <header>
      <div>
        <h1>FRS Gateway</h1>
        <p>Account Dashboard</p>
      </div>

      <a class="logout" href="/login">
        Logout
      </a>
    </header>

    <section class="welcome">
      <h2>Welcome, <span id="name">User</span></h2>
      <p>Your account dashboard is ready.</p>
    </section>

    <section class="details">

      <div class="detail">
        <span>Email Address</span>
        <strong id="email">—</strong>
      </div>

      <div class="detail">
        <span>SSN/span>
        <strong id="reference">—</strong>
      </div>

      <div class="detail">
        <span>Country</span>
        <strong id="country">—</strong>
      </div>

      <div class="detail">
        <span>Mobile</span>
        <strong id="mobile">—</strong>
      </div>

      <div class="detail">
        <span>Alternate Mobile</span>
        <strong id="alternate">—</strong>
      </div>

      <div class="detail">
        <span>Address</span>
        <strong id="address">—</strong>
      </div>

    </section>

    <div class="notice">
      FRS Gareway
    </div>

  </main>

  <script>
    const stored =
      sessionStorage.getItem("FRS Account");

    if (stored) {
      const account = JSON.parse(stored);

      document.querySelector("#name").textContent =
        account.fullName || "User";

      document.querySelector("#email").textContent =
        account.email || "—";

      document.querySelector("#reference").textContent =
        account.reference || "—";

      document.querySelector("#country").textContent =
        account.country || "—";

      document.querySelector("#mobile").textContent =
        account.mobile || "—";

      document.querySelector("#alternate").textContent =
        account.alternateMobile || "—";

      document.querySelector("#address").textContent =
        account.address || "—";
    }
  </script>

</body>
</html>

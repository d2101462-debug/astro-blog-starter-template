---
const title = "Account Dashboard";
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f6f8;
    }

    header {
      background: #123b63;
      color: white;
      padding: 20px 30px;
    }

    main {
      max-width: 900px;
      margin: 40px auto;
      padding: 20px;
    }

    .card {
      background: white;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 3px 15px rgba(0,0,0,.1);
    }

    .notice {
      margin-top: 20px;
      padding: 15px;
      background: #f1f1f1;
      font-size: 13px;
    }

    a {
      display: inline-block;
      margin-top: 20px;
    }
  </style>
</head>

<body>
  <header>
    <h1>Account Dashboard</h1>
  </header>

  <main>
    <div class="card">
      <h2>Welcome</h2>
      <p>Your fictional account portal dashboard.</p>

      <div class="notice">
        Fictional demonstration only. Not connected to any government
        agency, bank, or financial institution.
      </div>

      <a href="/">Return to Home</a>
    </div>
  </main>
</body>
</html>

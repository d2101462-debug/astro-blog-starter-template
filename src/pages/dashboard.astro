---
const portalName = "Fictional Account Portal";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title> Frs Gateway — Dashboard</title>
  </head>

  <body>
    <header>
      <strong>{portalName}</strong>

      <nav>
        <a href="/">Home</a>
        <a href="/dashboard">Dashboard</a>
      </nav>
    </header>

    <main>
      <h1>Welcome, <span id="userName">Account User</span></h1>

      <p class="subtitle">
        Your fictional account dashboard
      </p>

      <section class="cards">
        <div class="card">
          <span>Account Status</span>
          <strong>Active</strong>
        </div>

        <div class="card">
          <span>Profile</span>
          <strong>Complete</strong>
        </div>

        <div class="card">
          <span>Activity</span>
          <strong>0 transactions</strong>
        </div>
      </section>

      <section class="notice">
        <strong>Fictional portal</strong>
        <p>
          This dashboard is for demonstration purposes only and is not
          affiliated with any government agency, bank, or financial institution.
        </p>
      </section>

      <button id="logout">Log Out</button>
    </main>

    <script>
      const savedName = sessionStorage.getItem("portalUserName");

      if (savedName) {
        document.getElementById("userName").textContent = savedName;
      }

      document.getElementById("logout")?.addEventListener("click", () => {
        sessionStorage.removeItem("portalUserName");
        window.location.href = "/";
      });
    </script>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #172033;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 7%;
    background: white;
    border-bottom: 1px solid #ddd;
  }

  nav a {
    margin-left: 25px;
    color: #2457c5;
    text-decoration: none;
  }

  main {
    max-width: 1100px;
    margin: 45px auto;
    padding: 20px;
  }

  h1 {
    font-size: 36px;
    margin-bottom: 8px;
  }

  .subtitle {
    color: #5d6675;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 35px;
  }

  .card {
    background: white;
    padding: 28px;
    border-radius: 12px;
    box-shadow: 0 3px 15px rgba(0, 0, 0, 0.06);
  }

  .card span {
    display: block;
    color: #667085;
    margin-bottom: 12px;
  }

  .card strong {
    font-size: 22px;
  }

  .notice {
    margin-top: 30px;
    padding: 22px;
    background: #eef4ff;
    border-left: 4px solid #2457c5;
    border-radius: 6px;
  }

  #logout {
    margin-top: 25px;
    padding: 12px 22px;
    border: 0;
    border-radius: 6px;
    background: #555;
    color: white;
    cursor: pointer;
  }

  @media (max-width: 700px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>

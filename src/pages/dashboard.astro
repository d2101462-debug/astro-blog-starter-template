<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FRS Gateway — Dashboard</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f5f6f8;
      color: #172033;
    }

    .topbar {
      height: 64px;
      background: #17194d;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      font-weight: 600;
    }

    .layout {
      display: flex;
      min-height: calc(100vh - 64px);
    }

    .sidebar {
      width: 235px;
      background: white;
      border-right: 1px solid #ddd;
      display: flex;
      flex-direction: column;
    }

    .brand {
      padding: 22px 20px;
      border-bottom: 1px solid #ddd;
    }

    .brand-title {
      font-size: 21px;
      font-weight: 700;
      color: #20245d;
    }

    .brand-subtitle {
      margin-top: 4px;
      font-size: 12px;
      color: #687083;
    }

    .menu-title {
      padding: 20px 20px 8px;
      font-size: 12px;
      font-weight: 700;
      color: #6b7280;
      text-transform: uppercase;
    }

    .menu {
      padding: 0 10px;
    }

    .menu a {
      display: block;
      padding: 13px 14px;
      margin: 4px 0;
      border-radius: 7px;
      color: #20245d;
      text-decoration: none;
      font-size: 15px;
    }

    .menu a:hover,
    .menu a.active {
      background: #29256f;
      color: white;
    }

    .logout {
      margin-top: auto;
      padding: 20px;
      border-top: 1px solid #ddd;
    }

    .logout button {
      border: 0;
      background: none;
      color: #3c4355;
      cursor: pointer;
      font-size: 14px;
    }

    .main {
      flex: 1;
      padding: 30px;
      overflow-x: auto;
    }

    .account-bar {
      background: white;
      border-radius: 8px;
      padding: 18px 22px;
      border: 1px solid #e1e4ea;
      margin-bottom: 25px;
      display: flex;
      justify-content: space-between;
      gap: 20px;
    }

    .account-info {
      line-height: 1.8;
      font-size: 14px;
    }

    .account-info strong {
      color: #20245d;
    }

    .status {
      text-align: right;
      font-size: 13px;
      line-height: 1.8;
    }

    .status span {
      display: inline-block;
      background: #dff5e5;
      color: #207a3c;
      padding: 2px 10px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: bold;
    }

    h1 {
      margin: 0 0 25px;
      font-size: 30px;
      color: #20245d;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-bottom: 25px;
    }

    .card {
      background: white;
      border: 1px solid #e0e3e8;
      border-radius: 8px;
      padding: 22px;
      min-height: 115px;
    }

    .card-label {
      color: #596276;
      font-size: 14px;
      margin-bottom: 12px;
    }

    .card-value {
      font-size: 32px;
      color: #20245d;
      font-weight: 400;
    }

    .tables {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .table-box {
      background: white;
      border: 1px solid #e0e3e8;
      border-radius: 8px;
      overflow: hidden;
    }

    .table-title {
      padding: 18px;
      font-weight: 700;
      color: #20245d;
      border-bottom: 1px solid #e0e3e8;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      padding: 14px;
      text-align: left;
      border-bottom: 1px solid #edf0f3;
      font-size: 13px;
    }

    th {
      color: #555f73;
      font-weight: 700;
    }

    .empty {
      text-align: center;
      color: #7b8494;
      padding: 35px 10px;
    }

    .footer {
      text-align: center;
      margin-top: 45px;
      color: #6d7585;
      font-size: 12px;
    }

    @media (max-width: 900px) {
      .sidebar {
        width: 190px;
      }

      .cards {
        grid-template-columns: repeat(2, 1fr);
      }

      .tables {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 650px) {
      .layout {
        display: block;
      }

      .sidebar {
        width: 100%;
      }

      .logout {
        display: none;
      }

      .account-bar {
        display: block;
      }

      .status {
        text-align: left;
        margin-top: 10px;
      }

      .cards {
        grid-template-columns: 1fr;
      }

      .main {
        padding: 15px;
      }
    }
  </style>
</head>

<body>

  <header class="topbar">
    FDIC — Customer Support
  </header>

  <div class="layout">

    <aside class="sidebar">

      <div class="brand">
        <div class="brand-title">FRS GATEWAY</div>
        <div class="brand-subtitle">FDIC FINANCIAL SERVICES</div>
      </div>

      <div class="menu-title">Menu</div>

      <nav class="menu">
        <a href="/dashboard" class="active">▣ Dashboard</a>
        <a href="/dashboard">▣ Deposit</a>
        <a href="/dashboard">▣ Withdraw</a>
        <a href="/dashboard">⇄ Transfer</a>
        <a href="/dashboard">◌ Transactions</a>
        <a href="/dashboard">▱ Support</a>
        <a href="/dashboard">⚙ Settings</a>
      </nav>

      <div class="logout">
        <button id="logoutButton">↪ Log Out</button>
      </div>

    </aside>

    <main class="main">

      <section class="account-bar">

        <div class="account-info">
          <div>
            <strong>Account:</strong>
            <span id="accountNumber">Loading...</span>
          </div>

          <div>
            <strong>Name:</strong>
            <span id="accountName">Loading...</span>
          </div>

          <div>
            <strong>Account Type:</strong>
            Personal
          </div>
        </div>

        <div class="status">
          Account Status:
          <span>ACTIVE</span>
          <br />
          Online Session:
          <span>ACTIVE</span>
        </div>

      </section>

      <h1>Dashboard</h1>

      <section class="cards">

        <div class="card">
          <div class="card-label">Balance</div>
          <div class="card-value" id="balance">$0.00</div>
        </div>

        <div class="card">
          <div class="card-label">Pending Deposits</div>
          <div class="card-value">0</div>
        </div>

        <div class="card">
          <div class="card-label">Pending Withdrawals</div>
          <div class="card-value">0</div>
        </div>

        <div class="card">
          <div class="card-label">Today Transactions</div>
          <div class="card-value">0</div>
        </div>

      </section>

      <section class="tables">

        <div class="table-box">
          <div class="table-title">
            Latest Credits
          </div>

          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Transaction</th>
                <th>Source</th>
                <th>Status</th>
                <th>Amount</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td colspan="5" class="empty">
                  No credits yet.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="table-box">
          <div class="table-title">
            Latest Debits
          </div>

          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Transaction</th>
                <th>Amount</th>
                <th>Status</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td colspan="4" class="empty">
                  No debits yet.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

      </section>

      <div class="footer">
        Gateway Financial — Fictional demonstration interface
      </div>

    </main>

  </div>

  <script>
    const savedAccount = localStorage.getItem("fictionalAccount");

    if (savedAccount) {
      try {
        const account = JSON.parse(savedAccount);

        const nameElement =
          document.getElementById("accountName");

        const numberElement =
          document.getElementById("accountNumber");

        if (nameElement && account.fullName) {
          nameElement.textContent = account.fullName;
        }

        if (numberElement) {
          numberElement.textContent =
            account.accountNumber || "0000000000";
        }

      } catch (error) {
        console.error("Unable to read account:", error);
      }
    }

    document
      .getElementById("logoutButton")
      ?.addEventListener("click", () => {

        sessionStorage.removeItem("loggedIn");

        window.location.href = "/login/";
      });
  </script>

</body>
</html>

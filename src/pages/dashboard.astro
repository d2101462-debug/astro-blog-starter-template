---
const portalName = "Gateway Account Portal";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{portalName}</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f6f9;
      color: #172033;
    }

    .topbar {
      height: 58px;
      background: #111b55;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      font-weight: 600;
    }

    .layout {
      display: flex;
      min-height: calc(100vh - 58px);
    }

    .sidebar {
      width: 235px;
      background: #fff;
      border-right: 1px solid #d7dce5;
      display: flex;
      flex-direction: column;
    }

    .logo {
      padding: 24px 20px;
      border-bottom: 1px solid #ddd;
    }

    .logo-title {
      font-size: 20px;
      font-weight: 700;
      color: #18235f;
    }

    .logo-subtitle {
      margin-top: 4px;
      font-size: 11px;
      color: #697386;
      letter-spacing: 1px;
    }

    .menu-title {
      padding: 16px 20px 8px;
      font-size: 11px;
      color: #70798b;
      font-weight: 700;
    }

    .menu a {
      display: block;
      padding: 12px 20px;
      color: #202942;
      text-decoration: none;
      font-size: 14px;
      border-radius: 5px;
      margin: 2px 10px;
    }

    .menu a:hover,
    .menu a.active {
      background: #202b76;
      color: white;
    }

    .logout {
      margin-top: auto;
      padding: 20px;
      border-top: 1px solid #ddd;
    }

    .logout a {
      color: #596174;
      text-decoration: underline;
      font-size: 13px;
    }

    .main {
      flex: 1;
      padding: 28px 32px;
    }

    .account-info {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 25px;
    }

    .account-details {
      line-height: 1.8;
      font-size: 14px;
    }

    .account-details strong {
      color: #18235f;
    }

    .security {
      text-align: right;
      font-size: 13px;
      line-height: 2;
    }

    .status {
      display: inline-block;
      background: #16834b;
      color: white;
      border-radius: 12px;
      padding: 1px 10px;
      font-size: 11px;
      margin-left: 5px;
    }

    h1 {
      font-size: 30px;
      font-weight: 500;
      margin: 15px 0 30px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 28px;
    }

    .card {
      background: white;
      padding: 22px;
      border-radius: 5px;
      border: 1px solid #dce1e8;
      min-height: 105px;
    }

    .card-label {
      font-size: 13px;
      color: #56627a;
      margin-bottom: 10px;
    }

    .card-value {
      font-size: 29px;
      font-weight: 400;
      color: #1d2944;
    }

    .tables {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .table-box {
      background: white;
      border: 1px solid #dce1e8;
      border-radius: 5px;
      overflow: hidden;
    }

    .table-title {
      padding: 14px 16px;
      font-size: 14px;
      font-weight: 700;
      border-bottom: 1px solid #dce1e8;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th {
      text-align: left;
      font-size: 12px;
      padding: 12px;
      color: #47536b;
      border-bottom: 1px solid #e0e4ea;
    }

    td {
      padding: 18px 12px;
      font-size: 13px;
      color: #6a7384;
    }

    .empty {
      text-align: center;
      padding: 30px 10px;
    }

    .footer {
      text-align: center;
      margin-top: 45px;
      color: #667085;
      font-size: 12px;
    }

    .demo-label {
      position: fixed;
      right: 15px;
      bottom: 15px;
      background: #b42318;
      color: white;
      padding: 7px 12px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: bold;
      z-index: 20;
    }

    @media (max-width: 900px) {
      .sidebar {
        width: 190px;
      }

      .cards {
        grid-template-columns: repeat(2, 1fr);
      }

      .tables {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 650px) {
      .sidebar {
        display: none;
      }

      .main {
        padding: 20px;
      }

      .account-info {
        display: block;
      }

      .security {
        text-align: left;
        margin-top: 15px;
      }

      .cards {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <div class="topbar">
    ☎ Demo Support: Fictional Gateway Portal
  </div>

  <div class="layout">

    <aside class="sidebar">

      <div class="logo">
        <div class="logo-title">GATEWAY</div>
        <div class="logo-subtitle">ACCOUNT PORTAL</div>
      </div>

      <div class="menu-title">MENU</div>

      <nav class="menu">
        <a href="/dashboard" class="active">▣ &nbsp; Dashboard</a>
        <a href="#">▤ &nbsp; Deposit</a>
        <a href="#">▣ &nbsp; Withdraw</a>
        <a href="#">⇄ &nbsp; Transfer</a>
        <a href="#">◌ &nbsp; Transactions</a>
        <a href="#">▱ &nbsp; Support Ticket</a>
        <a href="#">⚙ &nbsp; Settings</a>
      </nav>

      <div class="logout">
        <a href="/">↪ &nbsp; Log Out</a>
      </div>

    </aside>

    <main class="main">

      <div class="account-info">

        <div class="account-details">
          <div>
            <strong>Account No:</strong>
            DEMO-482731
            &nbsp; | &nbsp;
            <strong>ID:</strong>
            ****1204
          </div>

          <div>
            <strong>Name:</strong>
            Sample User
            &nbsp; | &nbsp;
            <strong>Case ID:</strong>
            DEMO-001
          </div>
        </div>

        <div class="security">
          Demo Security:
          <span class="status">ON</span>
          <br />

          Demo Connection:
          <span class="status">ON</span>
        </div>

      </div>

      <h1>Dashboard</h1>

      <section class="cards">

        <div class="card">
          <div class="card-label">Balance</div>
          <div class="card-value">$25,000.00</div>
        </div>

        <div class="card">
          <div class="card-label">Pending Deposits</div>
          <div class="card-value">0</div>
        </div>

        <div class="card">
          <div class="card-label">Pending Withdrawals</div>
          <div class="card-value">0</div>
        </div>

        <div class="card">
          <div class="card-label">Today Transactions</div>
          <div class="card-value">0</div>
        </div>

      </section>

      <section class="tables">

        <div class="table-box">
          <div class="table-title">Latest Credits</div>

          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Txn</th>
                <th>Source</th>
                <th>Status</th>
                <th>Amount</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td colspan="5" class="empty">
                  No credits yet.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="table-box">
          <div class="table-title">Latest Debits</div>

          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Txn</th>
                <th>Amount</th>
                <th>Status</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td colspan="4" class="empty">
                  No debits yet.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

      </section>

      <div class="footer">
        Fictional Gateway Account Portal — created for demonstration purposes.
      </div>

    </main>

  </div>

  <div class="demo-label">FICTIONAL DEMO</div>

</body>
</html>

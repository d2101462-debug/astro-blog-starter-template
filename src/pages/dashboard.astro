---
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Account Dashboard</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f6fb;
      color: #11143b;
    }

    .header {
      background: white;
      border-bottom: 1px solid #ddd;
      padding: 22px 45px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 25px;
      font-weight: 700;
      color: #3436bd;
    }

    .logout {
      border: 1px solid #3436bd;
      background: white;
      color: #3436bd;
      padding: 10px 22px;
      border-radius: 7px;
      cursor: pointer;
    }

    .container {
      max-width: 1050px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .welcome {
      margin-bottom: 25px;
    }

    .welcome h1 {
      margin-bottom: 8px;
    }

    .welcome p {
      color: #68708b;
    }

    .account-card {
      background: white;
      border-radius: 12px;
      padding: 30px;
      box-shadow: 0 4px 18px rgba(0,0,0,.07);
      margin-bottom: 25px;
    }

    .account-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 25px;
    }

    .account-number {
      font-size: 17px;
      color: #68708b;
    }

    .account-number strong {
      color: #11143b;
    }

    .status {
      background: #e8f7ee;
      color: #168344;
      padding: 8px 15px;
      border-radius: 20px;
      font-size: 14px;
      font-weight: 600;
    }

    .balance {
      background: #f3f4ff;
      border-radius: 10px;
      padding: 25px;
      margin-bottom: 25px;
    }

    .balance-label {
      color: #68708b;
      margin-bottom: 8px;
    }

    .balance-value {
      font-size: 34px;
      font-weight: 700;
      color: #3436bd;
    }

    .details {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .detail {
      border: 1px solid #e0e3ec;
      border-radius: 8px;
      padding: 17px;
    }

    .detail-label {
      font-size: 14px;
      color: #747b93;
      margin-bottom: 7px;
    }

    .detail-value {
      font-size: 17px;
      font-weight: 600;
    }

    .notice {
      background: #fff;
      border-left: 4px solid #3436bd;
      padding: 18px;
      color: #5d647c;
      border-radius: 5px;
    }

    @media (max-width: 650px) {
      .details {
        grid-template-columns: 1fr;
      }

      .header {
        padding: 18px 20px;
      }

      .account-title {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
      }
    }
  </style>
</head>

<body>

  <header class="header">
    <div class="logo">Account Portal</div>

    <button class="logout" id="logout">
      Sign out
    </button>
  </header>

  <main class="container">

    <div class="welcome">
      <h1>Welcome, <span id="userName">User</span></h1>
      <p>Your account information is shown below.</p>
    </div>

    <section class="account-card">

      <div class="account-title">
        <div class="account-number">
          Account ID:
          <strong id="accountNumber">---</strong>
        </div>

        <div class="status">
          Active
        </div>
      </div>

      <div class="balance">
        <div class="balance-label">
          Account Balance
        </div>

        <div class="balance-value">
          $0.00
        </div>
      </div>

      <div class="details">

        <div class="detail">
          <div class="detail-label">Full Name</div>
          <div class="detail-value" id="name">---</div>
        </div>

        <div class="detail">
          <div class="detail-label">Email Address</div>
          <div class="detail-value" id="email">---</div>
        </div>

        <div class="detail">
          <div class="detail-label">Country</div>
          <div class="detail-value" id="country">---</div>
        </div>

        <div class="detail">
          <div class="detail-label">Mobile</div>
          <div class="detail-value" id="mobile">---</div>
        </div>

      </div>

    </section>

    <div class="notice">
      This is a fictional account portal. No real financial account,
      funds, or government-issued identification is represented.
    </div>

  </main>

  <script>
    const account = localStorage.getItem("account");

    if (!account) {
      window.location.href = "/";
    } else {
      const data = JSON.parse(account);

      document.getElementById("userName").textContent =
        data.name || "User";

      document.getElementById("name").textContent =
        data.name || "---";

      document.getElementById("email").textContent =
        data.email || "---";

      document.getElementById("country").textContent =
        data.country || "---";

      document.getElementById("mobile").textContent =
        data.mobile || "---";

      document.getElementById("accountNumber").textContent =
        data.accountNumber || "---";
    }

    document.getElementById("logout").addEventListener("click", () => {
      localStorage.removeItem("account");
      window.location.href = "/";
    });
  </script>

</body>
</html>

---
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Account Dashboard</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f6fb;
      color: #11143b;
    }

    header {
      background: #ffffff;
      border-bottom: 1px solid #ddd;
      padding: 22px 45px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 25px;
      font-weight: 700;
      color: #3436bd;
    }

    .logout {
      padding: 10px 22px;
      border: 1px solid #3436bd;
      border-radius: 7px;
      background: #ffffff;
      color: #3436bd;
      cursor: pointer;
    }

    .container {
      max-width: 1050px;
      margin: 40px auto;
      padding: 0 20px;
    }

    h1 {
      margin-bottom: 8px;
    }

    .subtitle {
      color: #68708b;
      margin-bottom: 25px;
    }

    .card {
      background: white;
      border-radius: 12px;
      padding: 30px;
      box-shadow: 0 4px 18px rgba(0,0,0,.07);
    }

    .top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 25px;
    }

    .account-id {
      color: #68708b;
    }

    .account-id strong {
      color: #11143b;
    }

    .status {
      background: #e8f7ee;
      color: #168344;
      padding: 8px 15px;
      border-radius: 20px;
      font-weight: 600;
    }

    .balance {
      background: #f3f4ff;
      border-radius: 10px;
      padding: 25px;
      margin-bottom: 25px;
    }

    .balance-label {
      color: #68708b;
      margin-bottom: 8px;
    }

    .balance-value {
      font-size: 34px;
      font-weight: 700;
      color: #3436bd;
    }

    .details {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .detail {
      border: 1px solid #e0e3ec;
      border-radius: 8px;
      padding: 17px;
    }

    .label {
      font-size: 14px;
      color: #747b93;
      margin-bottom: 7px;
    }

    .value {
      font-size: 17px;
      font-weight: 600;
      word-break: break-word;
    }

    .notice {
      margin-top: 25px;
      padding: 18px;
      background: white;
      border-left: 4px solid #3436bd;
      color: #5d647c;
    }

    @media (max-width: 650px) {
      header {
        padding: 18px 20px;
      }

      .details {
        grid-template-columns: 1fr;
      }

      .top {
        align-items: flex-start;
        gap: 15px;
        flex-direction: column;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">Account Portal</div>
    <button class="logout" id="logout">Sign out</button>
  </header>

  <main class="container">

    <h1>Welcome, <span id="userName">User</span></h1>

    <p class="subtitle">
      Your account information
    </p>

    <section class="card">

      <div class="top">
        <div class="account-id">
          Account ID:
          <strong id="accountNumber">---</strong>
        </div>

        <div class="status">
          Active
        </div>
      </div>

      <div class="balance">
        <div class="balance-label">
          Account Balance
        </div>

        <div class="balance-value">
          $0.00
        </div>
      </div>

      <div class="details">

        <div class="detail">
          <div class="label">Full Name</div>
          <div class="value" id="name">---</div>
        </div>

        <div class="detail">
          <div class="label">Email Address</div>
          <div class="value" id="email">---</div>
        </div>

        <div class="detail">
          <div class="label">Country</div>
          <div class="value" id="country">---</div>
        </div>

        <div class="detail">
          <div class="label">Mobile</div>
          <div class="value" id="mobile">---</div>
        </div>

      </div>

    </section>

    <div class="notice">
      Fictional account portal — no real financial account or
      funds are represented.
    </div>

  </main>
 </script>
  const storedAccount = localStorage.getItem("account");
  const account = storedAccount
    ? JSON.parse(storedAccount)
    : {
        name: "Test User",
        email: "test@example.com",
        country: "United States",
        mobile: "000-000-0000",
        accountNumber: "AC-00000000"
      };
  document.getElementById("userName").textContent =
    account.name;

  document.getElementById("name").textContent =
    account.name;

  document.getElementById("email").textContent =
    account.email;

  document.getElementById("country").textContent =
    account.country;

  document.getElementById("mobile").textContent =
    account.mobile;

  document.getElementById("accountNumber").textContent =
    account.accountNumber;

  document.getElementById("logout").addEventListener("click", () => {
    localStorage.removeItem("account");
    window.location.href = "/";
  });

</body>
</html>
